# arms — example configuration.
# Copy to ".env" and fill in real values. NEVER commit your real .env.

# --- ARMS NEX identity ---
# Access key read out of the game's own binary and confirmed three ways (see README.md).
# A WRONG access key fails SILENTLY at SYN: the PRUDP-Lite packet signature does not match,
# the console retries forever and neither side logs an error.
ARMS_ACCESS_KEY=b6b34c51
# 40305 = NEX 4.3.5, what the ARMS *update* links. The base game links 4.0.3 (40003).
ARMS_NEX_VERSION=40305

# --- Unverified wire-shape knobs (defaults = the Splatoon 2 / pre-Pia-5.19 profile) ---
# Station URL scheme handed back by auth. "prudps" makes the console send its Kerberos
# ticket in CONNECT; "prudp" completes the handshake but sends an EMPTY CONNECT payload.
ARMS_STATION_SCHEME=prudps
# PRUDP minor version answered in the SECURE endpoint's SYN-ACK. Never applied to auth.
ARMS_SECURE_MINOR=0
# 1 = legacy public station (type=0x03, no Pa), matching ARMS's measured Pia 5.7.0.
# 0 = the Switch Pia 5.19 shape (type=0x0B + Pa) used by SSBU/MK8.
ARMS_LEGACY_PIA=1
# 1 = answer DataStore (0x73) with the empty-list stub; 0 = let it return NotImplemented.
ARMS_DATASTORE_STUB=1

# --- Network ---
# BARE IP the console will dial. NOT host:port — this becomes the station URL's "address"
# param and the port is set separately from SECURE_PORT.
NEXTENDO_HOST=127.0.0.1
AUTH_PORT=443
SECURE_PORT=60006
NEXTENDO_PROXY_PROTOCOL=0

# --- TLS (both endpoints terminate TLS themselves) ---
CERT_FILE=cert.pem
KEY_FILE=key.pem

# --- Nextendo account integration ---
# Local testing: point at a port that refuses INSTANTLY. The gate client has a 3 s timeout
# and fails OPEN, so an unresolvable host silently adds ~3 s to every login.
NEXTENDO_ACCOUNT_URL=http://127.0.0.1:1
NEXTENDO_REQUIRE_ACCOUNT=0
NEXTENDO_REQUIRE_SIGNED_TOKEN=0

# --- Monitoring ---
# The dashboard is FAIL-CLOSED: with no token every /api request gets 403.
# 8086 rather than the sibling repos' 8082 so all four game servers can run at once.
DASH_PORT=8086
DASH_TOKEN=change-me
# Cosmetic only — displayed in /api/stats.
NEXTENDO_SNI_HOST=

# --- NAT bridge (needs nextendo-nncs running to be useful) ---
NNCS_NAT_FILE=local/nat_endpoints.txt

# --- Secrets (set these to strong random values in production) ---
NEXTENDO_INTERNAL_KEY=
# Token-signing secret: set the value directly...
NEXTENDO_SECRET=
# ...or point to a file that holds it (default: nextendo_secret.key next to the binary).
NEXTENDO_SECRET_FILE=
# Kerberos password shared between the auth and secure endpoints.
NEXTENDO_SECURE_PASSWORD=securepasswordplz1
